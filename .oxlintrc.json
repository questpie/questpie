{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y"],
	"rules": {
		"typescript/no-explicit-any": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"react/react-in-jsx-scope": "off",
		// TanStack column definitions and error-boundary fallbacks intentionally
		// pass memoized render callbacks as props; they are not component declarations
		// recreated directly in the rendered JSX tree.
		"react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
		"eslint/no-unused-vars": "warn",
		"eslint/no-shadow": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/no-array-sort": "off",
		// The repository targets an ES lib without Array#toReversed. Existing
		// reverse calls clone their arrays first, so they do not mutate inputs.
		"unicorn/no-array-reverse": "off",
		"unicorn/no-useless-fallback-in-spread": "off",
		"import/no-named-as-default": "off",
		"import/no-named-as-default-member": "off",
		"import/no-unassigned-import": "off",
		"jsx-a11y/anchor-has-content": "warn",
		"jsx-a11y/role-supports-aria-props": "warn",
		"jsx-a11y/no-static-element-interactions": "warn",
		"jsx-a11y/media-has-caption": "warn",
		"jsx-a11y/label-has-associated-control": "warn",
		"jsx-a11y/iframe-has-title": "warn"
	},
	"ignorePatterns": ["dist", ".next", ".generated", "node_modules", "*.min.js"],
	"overrides": [
		{
			// Zero-any packages stay zero-any (see scripts/any-census.ts).
			// hono/elysia/next still carry generic `<any>` wildcard
			// instantiations — add them here once those are typed.
			"files": ["packages/workflows/src/**"],
			"rules": {
				"typescript/no-explicit-any": "error"
			}
		},
		{
			// Type-level tests (`.test-d.ts`) assert types, not values. A bare
			// expression statement under `// @ts-expect-error` IS the assertion —
			// it exists to make tsc raise an error, and has no runtime purpose.
			// `no-unused-expressions` cannot see that and flags every one.
			"files": ["**/*.test-d.ts"],
			"rules": {
				"eslint/no-unused-expressions": "off"
			}
		}
	]
}
