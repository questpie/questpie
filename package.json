{
	"name": "questpie",
	"private": true,
	"workspaces": [
		"apps/*",
		"fixtures/*",
		"fixtures/*/packages/*",
		"packages/*"
	],
	"scripts": {
		"architecture:check": "bun run scripts/code-architecture.ts",
		"bench:micro": "bun run scripts/quality.ts micro",
		"build": "turbo run build",
		"check:changed": "bun run scripts/quality.ts changed",
		"dev": "turbo run dev",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"format:ratchet": "bun run scripts/format-ratchet.ts",
		"check-types": "turbo run types:check",
		"knip:report": "knip --no-exit-code --reporter compact",
		"knip:negative-control": "bun run scripts/knip-negative-control.ts",
		"knip:strict": "knip --strict --include unlisted,binaries,unresolved",
		"package:check": "bun run scripts/package-contract.ts",
		"quality:full": "bun run scripts/quality.ts full",
		"quality:release": "bun run scripts/quality.ts release",
		"quality:typescript-forward": "bun run scripts/quality.ts typescript-forward",
		"release": "bun run scripts/release.ts",
		"review:accept": "bun run .agents/skills/questpie-v4/scripts/claude-acceptance-review.ts",
		"skill:check": "skills-ref validate .agents/skills/questpie-v4",
		"test": "bun test",
		"test:postgres": "bun run scripts/quality.ts postgres",
		"test:load": "bun run scripts/quality.ts load",
		"test:soak": "bun run scripts/quality.ts soak"
	},
	"dependencies": {
		"@iconify/react": "^6.0.2",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.452",
		"@questpie/compiler": "workspace:*",
		"@types/bun": "1.3.14",
		"@typescript/native": "npm:typescript@7.0.2",
		"fumadocs-typescript": "^5.0.0",
		"jsdom": "^27.4.0",
		"knip": "6.32.1",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.56.0",
		"skills-ref": "0.1.5",
		"turbo": "^2.6.3",
		"typescript": "6.0.2"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"fast-uri": "^3.1.5",
		"hono": "^4.12.25",
		"js-yaml": "^4.3.1",
		"linkify-it": "^5.0.2",
		"nanoid": "^3.3.17",
		"postcss": "^8.5.18",
		"read-yaml-file": "^2.1.0",
		"shell-quote": "^1.9.0",
		"undici": "^7.28.0",
		"unrun": "0.2.39",
		"vite": "^8.0.16",
		"vitest": "^3.2.6",
		"ws": "8.21.0"
	},
	"engines": {
		"node": ">=20.19"
	},
	"packageManager": "bun@1.3.14"
}
