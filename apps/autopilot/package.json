{
	"name": "autopilot",
	"version": "0.0.13",
	"private": true,
	"type": "module",
	"imports": {
		"#questpie": "./src/questpie/server/.generated/index.ts",
		"#questpie/*": "./src/questpie/server/.generated/*"
	},
	"scripts": {
		"dev": "bun --conditions=development scripts/dev-all.ts",
		"dev:web": "bun --bun vite dev",
		"dev:all": "bun --conditions=development scripts/dev-all.ts",
		"dev:worker": "bun --bun run --watch ./src/worker.ts",
		"worker": "bun --bun run ./src/worker.ts",
		"dev:ai-worker": "bun --bun run --watch ./src/ai-worker.ts",
		"ai-worker": "bun --bun run ./src/ai-worker.ts",
		"dev:sandbox": "SANDBOX_BROKER_URL=http://127.0.0.1:3000/api/sandbox/rpc PORT=8787 deno run --allow-net --allow-env --allow-run --allow-read ../../packages/sandbox/src/sandbox-server.ts",
		"questpie": "bun --conditions=development ../../packages/questpie/src/exports/cli.ts",
		"generate": "bun run questpie generate -c src/questpie/server/questpie.config.ts",
		"db:setup": "bun run generate && bun run migrate:status && bun run migrate && bun run db:dev-admin && bun run db:seed",
		"db:dev-admin": "bun --conditions=development scripts/ensure-dev-admin.ts",
		"db:seed": "bun run questpie seed -c src/questpie/server/questpie.config.ts --category dev",
		"db:seed:status": "bun run questpie seed:status -c src/questpie/server/questpie.config.ts",
		"db:reset": "bun run generate && bun run migrate:fresh",
		"migrate": "bun run questpie migrate:up -c src/questpie/server/questpie.config.ts",
		"migrate:down": "bun run questpie migrate:down -c src/questpie/server/questpie.config.ts",
		"migrate:status": "bun run questpie migrate:status -c src/questpie/server/questpie.config.ts",
		"migrate:reset": "bun run questpie migrate:reset -c src/questpie/server/questpie.config.ts",
		"migrate:fresh": "bun run questpie migrate:fresh -c src/questpie/server/questpie.config.ts",
		"migrate:create": "bun run questpie migrate:create -c src/questpie/server/questpie.config.ts",
		"migrate:generate": "bun run questpie migrate:generate -c src/questpie/server/questpie.config.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.11",
		"@questpie/admin": "workspace:*",
		"@questpie/ai": "workspace:*",
		"@questpie/executor": "workspace:*",
		"@questpie/mcp": "workspace:*",
		"@questpie/sandbox": "workspace:*",
		"@questpie/workflows": "workspace:*",
		"@tailwindcss/vite": "^4.0.6",
		"@tanstack/react-query": "^5.62.11",
		"@tanstack/react-router": "^1.132.0",
		"@tanstack/react-start": "^1.132.0",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"nitro": "latest",
		"questpie": "workspace:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.0.6",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"@iconify/json": ">=2",
		"@iconify/react": "^6.0.2",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@questpie/vite-plugin-iconify": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"bun-types": "latest",
		"typescript": "^5.9.2",
		"vite": "^8.0.0",
		"vitest": "^3.2.6"
	}
}
