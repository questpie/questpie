{
	"name": "city-portal-example",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#questpie": "./src/questpie/server/.generated/index.ts",
		"#questpie/*": "./src/questpie/server/.generated/*"
	},
	"scripts": {
		"dev": "bun run dev:check && bun --bun vite dev --port 3001",
		"dev:check": "bun run ./scripts/check-dev-db.ts",
		"dev:worker": "bun --bun run --watch ./src/worker.ts",
		"worker": "bun --bun run ./src/worker.ts",
		"questpie:generate": "bun run node_modules/questpie/src/exports/cli.ts generate -c src/questpie/server/questpie.config.ts",
		"migrate": "bun run node_modules/questpie/src/exports/cli.ts migrate:up -c src/questpie/server/questpie.config.ts",
		"migrate:down": "bun run node_modules/questpie/src/exports/cli.ts migrate:down -c src/questpie/server/questpie.config.ts",
		"migrate:status": "bun run node_modules/questpie/src/exports/cli.ts migrate:status -c src/questpie/server/questpie.config.ts",
		"migrate:generate": "bun run node_modules/questpie/src/exports/cli.ts migrate:generate -c src/questpie/server/questpie.config.ts",
		"migrate:fresh": "bun run node_modules/questpie/src/exports/cli.ts migrate:fresh -c src/questpie/server/questpie.config.ts",
		"seed": "bun run seed.ts",
		"build": "vite build",
		"preview": "vite preview",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@iconify/react": "^6.0.2",
		"@questpie/admin": "workspace:*",
		"@questpie/openapi": "workspace:*",
		"@questpie/tanstack-query": "workspace:*",
		"@tailwindcss/vite": "^4.0.6",
		"@tanstack/react-query": "^5.62.11",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.167.42",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"next-themes": "^0.4.6",
		"nitro": "latest",
		"questpie": "workspace:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.0.6",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@iconify/json": ">=2",
		"@questpie/vite-plugin-iconify": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.0",
		"@tanstack/devtools-vite": "^0.3.11",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"bun-types": "latest",
		"typescript": "5.9.2",
		"vite": "^8.0.16",
		"vite-tsconfig-paths": "^5.1.4"
	}
}