{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun"]
	},
	"include": ["*.ts"]
}
