{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"questpie": ["framework.ts"],
			"#questpie/app": ["generated/app.ts"],
			"#questpie/package": ["generated/package.ts"]
		}
	},
	"include": ["*.ts", "generated/*.ts"]
}
