{
	"compilerOptions": {
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2024", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmitOnError": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": ["bun"]
	}
}
