{
	"name": "@questpie/observability",
	"version": "3.27.1",
	"description": "OpenTelemetry adapter for QUESTPIE — traces and metrics via OTLP",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/observability"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "bun test --timeout=60000 test/"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.221.0",
		"@opentelemetry/context-async-hooks": "^2.2.0",
		"@opentelemetry/core": "^2.2.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.2.0",
		"@opentelemetry/sdk-logs": "^0.221.0",
		"@opentelemetry/sdk-metrics": "^2.2.0",
		"@opentelemetry/sdk-trace-base": "^2.2.0",
		"@opentelemetry/semantic-conventions": "^1.43.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"bun-types": "latest",
		"drizzle-kit": "1.0.0-beta.6-4414a19",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"questpie": "workspace:^"
	}
}
