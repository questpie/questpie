{
	"name": "@questpie/agent-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Daemon + adapter contract for spawning and managing AI coding agents (Claude Code, Codex, etc.)",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/agent-runtime"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./adapters/claude-code": {
			"types": "./src/exports/adapters/claude-code.ts",
			"default": "./src/exports/adapters/claude-code.ts"
		},
		"./adapters/codex": {
			"types": "./src/exports/adapters/codex.ts",
			"default": "./src/exports/adapters/codex.ts"
		},
		"./relay": {
			"types": "./src/exports/relay.ts",
			"default": "./src/exports/relay.ts"
		},
		"./testing": {
			"types": "./src/exports/testing.ts",
			"default": "./src/exports/testing.ts"
		},
		"./worker": {
			"types": "./src/exports/worker.ts",
			"default": "./src/exports/worker.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./adapters/claude-code": {
				"types": "./dist/adapters/claude-code.d.mts",
				"default": "./dist/adapters/claude-code.mjs"
			},
			"./adapters/codex": {
				"types": "./dist/adapters/codex.d.mts",
				"default": "./dist/adapters/codex.mjs"
			},
			"./relay": {
				"types": "./dist/relay.d.mts",
				"default": "./dist/relay.mjs"
			},
			"./testing": {
				"types": "./dist/testing.d.mts",
				"default": "./dist/testing.mjs"
			},
			"./worker": {
				"types": "./dist/worker.d.mts",
				"default": "./dist/worker.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"bun-types": "latest",
		"spawn-agent": "0.0.1",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"spawn-agent": "*"
	},
	"peerDependenciesMeta": {
		"spawn-agent": {
			"optional": true
		}
	}
}
