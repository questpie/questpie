{
	"name": "@questpie/runtime",
	"version": "4.0.0-beta.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./bundle": "./src/bundle.ts",
		"./bundle-core": "./src/bundle-core.ts",
		"./bundle-realtime": "./src/bundle-realtime.ts"
	},
	"scripts": {
		"build": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json && bun scripts/copy-source-declarations.ts",
		"types:check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"pg": "8.22.0",
		"questpie": "workspace:*"
	},
	"devDependencies": {
		"@types/pg": "8.20.0"
	}
}
