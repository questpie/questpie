{
	"name": "@questpie/testing",
	"version": "3.21.1",
	"description": "Typed application and production-scenario testing tools for QUESTPIE",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/testing"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./scenario": {
			"types": "./src/scenario.ts",
			"default": "./src/scenario.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./scenario": {
				"types": "./dist/scenario.d.mts",
				"default": "./dist/scenario.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/pg": "^8.16.0",
		"bun-types": "latest",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"questpie": "workspace:*",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"questpie": "workspace:^"
	}
}
