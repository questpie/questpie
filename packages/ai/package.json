{
	"name": "@questpie/ai",
	"version": "3.1.1",
	"description": "AI module for QuestPie run and worker execution",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/ai"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./client": {
			"types": "./src/exports/client.ts",
			"default": "./src/exports/client.ts"
		},
		"./client/modules/ai": {
			"types": "./src/exports/client/modules/ai.ts",
			"default": "./src/exports/client/modules/ai.ts"
		},
		"./harness-core": {
			"types": "./src/exports/harness-core.ts",
			"default": "./src/exports/harness-core.ts"
		},
		"./modules/ai": {
			"types": "./src/exports/modules/ai.ts",
			"default": "./src/exports/modules/ai.ts"
		},
		"./worker": {
			"types": "./src/exports/worker.ts",
			"default": "./src/exports/worker.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./client": {
				"types": "./dist/client.d.mts",
				"default": "./dist/client.mjs"
			},
			"./client/modules/ai": {
				"types": "./dist/client/modules/ai.d.mts",
				"default": "./dist/client/modules/ai.mjs"
			},
			"./harness-core": {
				"types": "./dist/harness-core.d.mts",
				"default": "./dist/harness-core.mjs"
			},
			"./modules/ai": {
				"types": "./dist/modules/ai.d.mts",
				"default": "./dist/modules/ai.mjs"
			},
			"./worker": {
				"types": "./dist/worker.d.mts",
				"default": "./dist/worker.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"questpie:generate": "bun questpie generate --verbose"
	},
	"dependencies": {
		"@ai-sdk/harness": "1.0.0-canary.9",
		"@ai-sdk/harness-claude-code": "1.0.0-canary.5",
		"@ai-sdk/provider-utils": "5.0.0-canary.48",
		"@iconify/react": "^6.0.2",
		"@questpie/admin": "workspace:*",
		"ai": "7.0.0-canary.173",
		"questpie": "workspace:*",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@tanstack/react-query": "^5.x",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"bun-types": "latest",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"@questpie/admin": "^3.0.0",
		"@tanstack/react-query": "^5.x",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"questpie": "^3.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.2.1"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		},
		"@questpie/admin": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
