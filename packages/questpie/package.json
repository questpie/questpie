{
	"name": "questpie",
	"version": "3.2.7",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/questpie"
	},
	"bin": {
		"questpie": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"imports": {
		"#questpie/*": "./src/*"
	},
	"exports": {
		".": "./src/exports/index.ts",
		"./adapters/bullmq": "./src/exports/adapters/bullmq.ts",
		"./adapters/cloudflare": "./src/exports/adapters/cloudflare.ts",
		"./adapters/cloudflare-kv": "./src/exports/adapters/cloudflare-kv.ts",
		"./adapters/cloudflare-queues": "./src/exports/adapters/cloudflare-queues.ts",
		"./adapters/cloudflare-realtime": "./src/exports/adapters/cloudflare-realtime.ts",
		"./adapters/console": "./src/exports/adapters/console.ts",
		"./adapters/memory-kv": "./src/exports/adapters/memory-kv.ts",
		"./adapters/pg-boss": "./src/exports/adapters/pg-boss.ts",
		"./adapters/pg-notify": "./src/exports/adapters/pg-notify.ts",
		"./adapters/pgvector-search": "./src/exports/adapters/pgvector-search.ts",
		"./adapters/plunk": "./src/exports/adapters/plunk.ts",
		"./adapters/postgres-search": "./src/exports/adapters/postgres-search.ts",
		"./adapters/redis-kv": "./src/exports/adapters/redis-kv.ts",
		"./adapters/redis-streams": "./src/exports/adapters/redis-streams.ts",
		"./adapters/resend": "./src/exports/adapters/resend.ts",
		"./adapters/smtp": "./src/exports/adapters/smtp.ts",
		"./cli": "./src/exports/cli.ts",
		"./client": "./src/exports/client.ts",
		"./drizzle": "./src/exports/drizzle.ts",
		"./drizzle-pg-core": "./src/exports/drizzle-pg-core.ts",
		"./shared": "./src/exports/shared.ts",
		"./*": "./*"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./adapters/bullmq": "./dist/adapters/bullmq.mjs",
			"./adapters/cloudflare": "./dist/adapters/cloudflare.mjs",
			"./adapters/cloudflare-kv": "./dist/adapters/cloudflare-kv.mjs",
			"./adapters/cloudflare-queues": "./dist/adapters/cloudflare-queues.mjs",
			"./adapters/cloudflare-realtime": "./dist/adapters/cloudflare-realtime.mjs",
			"./adapters/console": "./dist/adapters/console.mjs",
			"./adapters/memory-kv": "./dist/adapters/memory-kv.mjs",
			"./adapters/pg-boss": "./dist/adapters/pg-boss.mjs",
			"./adapters/pg-notify": "./dist/adapters/pg-notify.mjs",
			"./adapters/pgvector-search": "./dist/adapters/pgvector-search.mjs",
			"./adapters/plunk": "./dist/adapters/plunk.mjs",
			"./adapters/postgres-search": "./dist/adapters/postgres-search.mjs",
			"./adapters/redis-kv": "./dist/adapters/redis-kv.mjs",
			"./adapters/redis-streams": "./dist/adapters/redis-streams.mjs",
			"./adapters/resend": "./dist/adapters/resend.mjs",
			"./adapters/smtp": "./dist/adapters/smtp.mjs",
			"./cli": "./dist/cli.mjs",
			"./client": "./dist/client.mjs",
			"./drizzle": "./dist/drizzle.mjs",
			"./drizzle-pg-core": "./dist/drizzle-pg-core.mjs",
			"./shared": "./dist/shared.mjs",
			"./*": "./*"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "QUESTPIE_MIGRATIONS_SILENT=1 bun test --max-concurrency=1",
		"test:watch": "bun test --watch",
		"check-types": "tsc --noEmit",
		"questpie:generate": "bun run ./src/exports/cli.ts generate --verbose",
		"dev": "bun run --watch src/index.ts"
	},
	"dependencies": {
		"@drepkovsky/tinydi": "^2.3.0",
		"better-auth": "^1.4.9",
		"commander": "^14.0.2",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"flydrive": "^1.3.0",
		"html-to-text": "^9.0.5",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"qs": "^6.13.1",
		"superjson": "^2.2.6",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"@types/html-to-text": "^9.0.4",
		"@types/nodemailer": "^7.0.5",
		"@types/pg": "^8.16.0",
		"@types/qs": "^6.9.17",
		"@types/react": "^19.2.7",
		"bullmq": "^5.0.0",
		"bun-types": "latest",
		"drizzle-kit": "1.0.0-beta.6-4414a19",
		"nodemailer": "^7.0.12",
		"pg": "^8.13.1",
		"pg-boss": "^12.5.4",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"@react-email/components": "^1.0.2",
		"@react-email/render": "^2.0.0",
		"bullmq": "^5.0.0",
		"drizzle-kit": "1.0.0-beta.6-4414a19",
		"nodemailer": "^7.0.12",
		"pg": "^8.13.1",
		"pg-boss": "^12.5.4"
	},
	"peerDependenciesMeta": {
		"@react-email/components": {
			"optional": true
		},
		"@react-email/render": {
			"optional": true
		},
		"bullmq": {
			"optional": true
		},
		"drizzle-kit": {
			"optional": true
		},
		"nodemailer": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"pg-boss": {
			"optional": true
		}
	}
}
