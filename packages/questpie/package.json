{
	"name": "questpie",
	"version": "4.0.0-beta.1",
	"bin": {
		"questpie": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun ../../scripts/build-public-package.ts",
		"types:check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@types/bun": "1.3.14",
		"typescript": "6.0.2"
	}
}
