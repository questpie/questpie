{
	"name": "@questpie/executor",
	"version": "3.0.11",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/executor"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./modules/executor": {
			"types": "./src/exports/modules/executor.ts",
			"default": "./src/exports/modules/executor.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./modules/executor": {
				"types": "./dist/modules/executor.d.mts",
				"default": "./dist/modules/executor.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"questpie": "workspace:*"
	},
	"devDependencies": {
		"bun-types": "latest",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"questpie": "^3.0.0"
	}
}
