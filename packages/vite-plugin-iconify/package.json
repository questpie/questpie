{
	"name": "@questpie/vite-plugin-iconify",
	"version": "0.0.2",
	"description": "Vite plugin that auto-bundles only the Iconify icons you use",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/vite-plugin-iconify"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"@iconify/json": ">=2",
		"tsdown": "^0.18.3",
		"typescript": "5.9.2",
		"vite": ">=6"
	},
	"peerDependencies": {
		"@iconify/json": ">=2",
		"vite": ">=6"
	}
}
