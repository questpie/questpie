{
	"name": "@questpie/mcp",
	"version": "3.27.1",
	"description": "Model Context Protocol server for QUESTPIE apps, under the app's own access rules",
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/mcp"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./modules/mcp": {
			"types": "./src/exports/modules/mcp.ts",
			"default": "./src/exports/modules/mcp.ts"
		},
		"./plugin": {
			"types": "./src/exports/plugin.ts",
			"default": "./src/exports/plugin.ts"
		},
		"./stdio": {
			"types": "./src/exports/stdio.ts",
			"default": "./src/exports/stdio.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./modules/mcp": {
				"types": "./dist/modules/mcp.d.mts",
				"default": "./dist/modules/mcp.mjs"
			},
			"./plugin": {
				"types": "./dist/plugin.d.mts",
				"default": "./dist/plugin.mjs"
			},
			"./stdio": {
				"types": "./dist/stdio.d.mts",
				"default": "./dist/stdio.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"questpie:generate": "bun run ../questpie/src/exports/cli.ts generate --verbose",
		"test": "bun test ./test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"questpie": "workspace:*",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@better-auth/oauth-provider": "^1.6.23",
		"better-auth": "^1.6.23",
		"bun-types": "latest",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"questpie": "workspace:^"
	}
}
