{
	"name": "@questpie/mcp",
	"version": "3.2.7",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/questpie/questpie.git",
		"directory": "packages/mcp"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./plugin": {
			"types": "./src/exports/plugin.ts",
			"default": "./src/exports/plugin.ts"
		},
		"./stdio": {
			"types": "./src/exports/stdio.ts",
			"default": "./src/exports/stdio.ts"
		},
		"./package.json": {
			"types": "./package.json",
			"default": "./package.json"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./plugin": {
				"types": "./dist/plugin.d.mts",
				"default": "./dist/plugin.mjs"
			},
			"./stdio": {
				"types": "./dist/stdio.d.mts",
				"default": "./dist/stdio.mjs"
			},
			"./package.json": {
				"types": "./package.json",
				"default": "./package.json"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"questpie": "workspace:*",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"bun-types": "latest",
		"tsdown": "^0.18.3"
	},
	"peerDependencies": {
		"questpie": "^3.0.0"
	}
}
